<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-chat-history-sync.watcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/ABSOLUTE/PATH/TO/ai-chat-history-sync/ai_chat_history/sync_ai_chats.py</string>
    <string>watch</string>
    <string>--archive-root</string>
    <string>/ABSOLUTE/PATH/TO/AI Chat History</string>
    <string>--interval</string>
    <string>60</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/ai-chat-history-sync</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/AI Chat History/state/watcher.out.log</string>

  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/AI Chat History/state/watcher.err.log</string>
</dict>
</plist>
